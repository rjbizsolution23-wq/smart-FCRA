{
  "name": "fcra-detector",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist --d1=fcra-detector-production --local --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist --project-name fcra-detector",
    "db:migrate:local": "wrangler d1 migrations apply fcra-detector-production --local",
    "db:seed": "wrangler d1 execute fcra-detector-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "hono": "^4.12.12",
    "jspdf": "^4.2.1",
    "stripe": "^15.0.0"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}