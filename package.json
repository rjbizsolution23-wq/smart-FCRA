{
  "name": "fcra-detector-v2",
  "version": "2.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist --d1=fcra-detector-v2 --local --ip 0.0.0.0 --port 3000",
    "deploy": "npm run build && wrangler pages deploy dist --project-name smart-fcra-v2",
    "db:create": "wrangler d1 create fcra-detector-v2",
    "db:migrate:local": "wrangler d1 migrations apply fcra-detector-v2 --local",
    "db:seed": "wrangler d1 execute fcra-detector-v2 --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "test:unit": "npx tsx tests/unit-auth-crypto.mjs",
    "test:e2e": "npx playwright test"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "hono": "^4.12.12",
    "jspdf": "^4.2.1",
    "lucide-react": "1.24.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "^15.0.0"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
