# Local Wrangler / Pages secrets (copy to .dev.vars — never commit .dev.vars)
PII_ENCRYPTION_KEY=local-dev-only-pii-key-min-32-chars!!
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
ENVIRONMENT=development
FREE_AI_ONLY=true
# Optional partner integrations (leave blank for sandbox demos):
# MFSN_EMAIL=
# MFSN_PASSWORD=
# MFSN_CLIENT_TOKEN=   # partner token — public /?signup=mfsn uses this; consumers enter username/password
# MFSN_API_URL=https://api.myfreescorenow.com
# PUBLIC_SIGNUP_ORG_ID=org_platform_master
# Twilio SMS (client texting from CRM + signup welcome)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# GoHighLevel CRM sync
# GHL_PIT_TOKEN=pit-xxxxxxxx
# GHL_LOCATION_ID=
# STRIPE_API_KEY=
# JOURNEY_CRON_SECRET=
