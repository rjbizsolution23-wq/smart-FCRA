# Smart FCRA v2 — paste your real values below, then upload this file to the agent.
# DO NOT commit this file. The agent will load it into .dev.vars / Cloudflare secrets only.

# ── Core ──────────────────────────────────────────────────────
ENVIRONMENT=production
FRONTEND_URL=https://YOUR-V2-PAGES-URL.pages.dev
PII_ENCRYPTION_KEY=REPLACE_WITH_32+_CHAR_RANDOM_SECRET

# Optional platform owner bootstrap (never hardcode in source)
PLATFORM_BOOTSTRAP_EMAIL=
PLATFORM_BOOTSTRAP_PASSWORD=

# ── Stripe ────────────────────────────────────────────────────
STRIPE_API_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PROFESSIONAL_PRICE_ID=price_...
STRIPE_UNLIMITED_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# ── Email (Resend) ────────────────────────────────────────────
RESEND_API_KEY=re_...
# Optional from-address override used by transactional mail
RESEND_FROM_EMAIL=Smart FCRA <noreply@yourdomain.com>

# ── SmartCredit / ConsumerDirect ─────────────────────────────
SMARTCREDIT_CLIENT_KEY=
SMARTCREDIT_CLIENT_SECRET=
# If you use username/password sandbox accounts, note them in a comment — do not put client logins in server secrets unless intentional

# ── Click2Mail (certified mail) ───────────────────────────────
CLICK2MAIL_USERNAME=
CLICK2MAIL_AUTH_BASIC=
CLICK2MAIL_API_URL=https://stage-api.click2mail.com

# ── Mailing status webhook ────────────────────────────────────
MAILING_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_SECRET

# ── Cloudflare (for deploy / remote D1 from this environment) ─
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ── Optional observability ────────────────────────────────────
SENTRY_DSN=

# ── D1 (after: wrangler d1 create fcra-detector-v2) ────────────
# Paste the UUID into wrangler.toml / wrangler.jsonc database_id
# D1_DATABASE_ID=
